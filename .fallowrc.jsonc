// Cấu hình Fallow — https://fallow.mintlify.app/configuration/overview
//
// Hai nguồn false positive có hệ thống của repo này, cả hai đều là *cấu trúc*
// chứ không phải code sai, nên khai ở đây thay vì sửa code cho vừa lòng tool:
//
//  1. Nạp module bằng glob lúc chạy — Fallow đọc tĩnh nên không thấy đường nào
//     dẫn vào `src/features/**` và báo nguyên cây là dead code.
//  2. Dòng source gitignore `/tests/` (`docs/agent-rules/git-pr.md` §4.3) nên
//     không có consumer nào là test, và cũng không có alias/shim nào của dòng
//     test để resolve import.
{
  // ── 1. Điểm nạp động ────────────────────────────────────────────────────
  // Không có static import nào trỏ tới các file dưới đây; chúng được gom bằng
  // glob lúc chạy. Thiếu mục này thì mỗi feature mới đều kéo theo một loạt
  // `unused-file` + `unused-export` cho toàn bộ cây của nó.
  "dynamicallyLoaded": [
    // Backend: `registerFeatureRoutes` quét `src/features/<name>/` bằng
    // `loadEntriesUnder` (`src/backend/apiServer.ts`): `api.ts` kiểu cũ và
    // `controller.ts` / `controllers/*.ts` kiểu decorator (#508). Đây là các điểm
    // nạp feature DUY NHẤT của backend — mọi thứ khác của feature treo dưới chúng.
    "src/features/*/api.ts",
    "src/features/*/controller.ts",
    "src/features/*/controllers/*.ts",
    // Frontend: `import.meta.glob(..., { eager: true })` ở `frontend/main.ts`
    // (mode registry, style theo feature).
    "src/features/*/registerMode.ts",
    "src/features/*/styles/index.scss"
  ],

  // ── 2. Gói chỉ dòng test dùng / chỉ dòng test resolve được ───────────────
  // "Luôn coi là đã dùng và luôn coi là có mặt."
  "ignoreDependencies": [
    // Gói chỉ test dùng — gỡ khỏi `package.json` sẽ làm suite chết.
    "@vue/test-utils"
  ],

  // `zod` CÓ trong `package.json`, nhưng alias của nó trỏ vào `tests/shims/zod.ts`
  // (`vitest.config.ts`: zod 3.25 dual-package làm Vite để named `{ z }` undefined).
  // Shim sống ở dòng test nên bước Fallow không resolve được, và MỌI
  // `src/features/*/schemas/*.ts` báo `unresolved-import`.
  // ⚠️ Phải là `ignoreUnresolvedImports`, không phải `ignoreDependencies`: đã thử
  // `ignoreDependencies` trước và 7 finding `unresolved-import` vẫn còn nguyên —
  // key đó chỉ nói về *dependency chết*, không nói về *specifier không resolve được*.
  "ignoreUnresolvedImports": ["zod"],

  // Method của controller được gắn route bằng CHUỖI — `bind(MonitorController,
  // 'putTaskOrchestrator')` ở `features/<name>/api.ts` — nên không có tham chiếu
  // tĩnh nào tới method, và Fallow báo mọi handler mới là `unused-class-member`.
  // Đây là khuôn của TOÀN BỘ controller trong repo (`backend/http/AbstractController.ts`),
  // không riêng feature nào ⇒ tắt theo đường dẫn thay vì rắc suppression từng method.
  // Controller kiểu decorator (#508) cũng vậy: `@Get(path)` ghi tên method vào
  // metadata, `registerControllers` gọi lại theo tên.
  "overrides": [
    {
      "files": ["src/features/*/controller.ts", "src/features/*/controllers/*.ts"],
      "rules": { "unused-class-members": "off" }
    },
    {
      // Thành viên chỉ được gọi qua hợp đồng, không qua tên lớp cụ thể — Fallow không
      // nối member của interface / lớp cha với hiện thực:
      // - `FormRequest`: `registerControllers` đọc `schema` / `source` / `invalid` qua
      //   kiểu `FormRequestClass` và gọi `prepare()` / `after()` mà lớp con ghi đè.
      // - Provider runner: caller lấy provider từ `getProvider(id)` (Map) dưới kiểu
      //   `RunnerProvider`, nên `execute`, `catalog`, `transcriptFormat`, `complete`…
      //   của từng hiện thực không có tham chiếu tĩnh nào.
      "files": ["src/backend/http/FormRequest.ts", "src/features/runner/business/providers/*.ts"],
      "rules": { "unused-class-members": "off" }
    }
  ],

  // ── 3. Export có consumer, nhưng consumer nằm ở dòng test ───────────────
  // Hàm được tách ra và export *để test gọi thẳng không cần LLM / không cần
  // dựng cả vòng lặp*. Trên dòng source chúng trông như không ai dùng.
  // Bật cờ này trước: phần lớn nhóm đó vẫn được gọi ngay trong file khai nó,
  // nên không cần liệt kê tay.
  "ignoreExportsUsedInFile": true,

  // Phần còn lại — export KHÔNG được dùng trong chính file khai, consumer duy
  // nhất là test ở `test/x.y.z/…`. Khai theo từng file, không dùng `"*"` ở mức
  // thư mục, để export chết thật vẫn bị bắt.
  "ignoreExports": [
    {
      // `_resetOrchestratorForTest` (dọn state giữa các case) và
      // `SWEEP_INTERVAL_MS` (test khẳng định chu kỳ quét).
      "file": "src/features/orchestrator/business/decisionLoop.ts",
      "exports": ["_resetOrchestratorForTest", "SWEEP_INTERVAL_MS"]
    },
    {
      // `setOrchestratorEnabledFlag` — production chỉ gọi nội bộ trong
      // `resolveOrchestration`; test gọi thẳng để kiểm nó không đụng field khác
      // của task state.
      "file": "src/features/monitor/business/tasks/startAuthority.ts",
      "exports": ["setOrchestratorEnabledFlag"]
    },
    {
      // Test đọc thẳng tầng đĩa của i18n (bundle chưa memo, ETag, gốc repo).
      "file": "src/features/i18n/business/index.ts",
      "exports": ["REPO_LOCALES", "localeEtag", "readLocaleBundle"]
    },
    {
      // Bộ decorator đầy đủ của khuôn controller (#508). Mới `statistics` chuyển sang
      // decorator và chỉ dùng `@Get`; các decorator còn lại có test riêng và là đích
      // của các feature chuyển sau.
      "file": "src/backend/http/decorators.ts",
      "exports": ["Post", "Put", "Patch", "Delete", "Raw"]
    },
    {
      // Gắn cả danh sách controller trong một lệnh — test dựng app nhỏ bằng nó;
      // `apiServer` gọi `registerController` từng cái để xen với `api.ts` kiểu cũ.
      "file": "src/backend/http/registerControllers.ts",
      "exports": ["registerControllers"]
    },
    {
      // Cặp `Dto` / `DtoInput` của `src/shared/type` — test khoá kiểu đầu vào.
      "file": "src/shared/type/dto.ts",
      "exports": ["DtoInput"]
    },
    {
      // Test thay driver log (driver giả ghi lại `LogQuery`) rồi trả về mặc định.
      "file": "src/backend/log/driverInit.ts",
      "exports": ["resetLogDriver"]
    },
    {
      "file": "src/backend/log/index.ts",
      "exports": ["setLogDriver", "resetLogDriver", "LogQuery"]
    },
    {
      // Test knowledge dựng driver giả theo hợp đồng `KnowledgeDriver`, import qua barrel.
      "file": "src/features/knowledge/business/index.ts",
      "exports": ["KnowledgeDriver"]
    },
    {
      // Seam test của runner (#440): `registerProvider` thay provider bằng stub.
      // `listProviderIds` / `transcriptFormatOf` / `providerDescriptorOf` /
      // `agentTranscriptFile` / `resolveProviderApiKey` là hook mở cho #441 · #445 ·
      // #448 — test hợp đồng gọi qua barrel.
      "file": "src/features/runner/business/providers/providerRegistry.ts",
      "exports": ["registerProvider", "listProviderIds", "transcriptFormatOf"]
    },
    {
      "file": "src/features/runner/business/index.ts",
      "exports": [
        "registerProvider",
        "listProviderIds",
        "transcriptFormatOf",
        "providerDescriptorOf",
        "agentTranscriptFile",
        "resolveProviderApiKey"
      ]
    },
    {
      // Re-export giữ path import cũ cho test khi #440 tách `providers/` — chỉ test còn
      // import qua hai path này. Test chuyển sang `providers/…` thì xoá re-export.
      "file": "src/features/runner/business/registry.ts",
      "exports": ["cleanupOrphanedMcpDeliveries", "getProvider", "listProviderCatalog", "providerFamilyOf"]
    },
    {
      "file": "src/features/runner/business/types.ts",
      "exports": ["ExecuteRequest", "ExecuteResult", "McpDelivery", "ProviderFamily", "RunnerProvider", "UsageCaptureInput"]
    },
    {
      // Test gọi thẳng: nhận diện provider Agent CLI · argv parse-json của cursor.
      "file": "src/features/runner/business/providers/AbstractAgentCliProvider.ts",
      "exports": ["isAgentCliProvider"]
    },
    {
      "file": "src/features/runner/business/providers/CursorCliProvider.ts",
      "exports": ["buildCursorJsonArgs"]
    }
  ],

  // ── 4. CRAP: không đo được coverage ở bước này ──────────────────────────
  // Cùng gốc với nguồn false positive #2 (dòng source gitignore `/tests/`),
  // nhưng ở chiều khác: `high-crap-score` cần coverage, mà bước Fallow không
  // chạy test và không được truyền `--coverage`, nên fallow *ước lượng* —
  // `coverage_source: "estimated"`, `coverage_tier: "none"` cho MỌI hàm
  // (`coverage_source_consistency: "uniform"` trong output JSON).
  //
  // Với coverage = 0, công thức Savoia–Evans `CC^2 * (1 - cov)^3 + CC` rút
  // gọn thành `CC^2 + CC`. Ở ngưỡng mặc định 30, rule đó KHÔNG còn nói gì về
  // test — nó chỉ là một cổng cyclomatic thứ hai, ngưỡng hiệu dụng CC >= 5,
  // trong khi cổng cyclomatic thật đang là 20. Hệ quả: mọi hàm có nhánh
  // vừa phải đều đỏ, và tín hiệu "phức tạp thật" chìm trong đó.
  //
  // `20^2 + 20 = 420` là điểm mà CRAP vừa đúng KHÔNG còn bind trước cổng
  // cyclomatic ở coverage = 0: nó chỉ kêu khi `maxCyclomatic` đã kêu. Không
  // phải con số chọn bừa, và không tắt hẳn dimension.
  //
  // ⚠️ Hạ lại về 30 ngay khi bước Fallow được truyền `--coverage` (Istanbul
  // `coverage-final.json`) — lúc đó CRAP mới đo đúng thứ nó định đo. Còn
  // `maxCyclomatic` / `maxCognitive` giữ nguyên mặc định: hai dimension đó
  // không phụ thuộc coverage nên vẫn bắt được phức tạp thật.
  "health": { "maxCrap": 420 }
}
