# Sample env for docker compose (copy → docker/.env hoặc export trước khi up).
#
#   cp docker/.env.example docker/.env
#   # hoặc: ./docker/install.sh

# LinuxServer-style — trùng user sở hữu ~/workspace (hoặc DEV_TEAM_PROJECT_PATH)
PUID=1000
PGID=1000

# Home host (Claude/Cursor auth) — dùng với compose.runners.yml
HOST_HOME=/home/youruser

# Project mount → /data/project (mặc định ~/workspace nếu không set)
DEV_TEAM_PROJECT_PATH=/home/youruser/workspace

DEV_TEAM_DASHBOARD_PORT=5174

# Optional
# ANTHROPIC_API_KEY=
# CURSOR_API_KEY=
# FIX_PROJECT_OWNERSHIP=0
