# cp docker/.env.example docker/.env

PUID=1000
PGID=1000
HOST_HOME=/home/youruser
DEV_TEAM_PROJECT_PATH=/home/youruser/workspace
DEV_TEAM_DASHBOARD_PORT=5174

# ANTHROPIC_API_KEY=
# CURSOR_API_KEY=
# CLAUDE_CODE_OAUTH_TOKEN=

# FIX_PROJECT_OWNERSHIP — mặc định 0 (tắt).
# Khi =1: entrypoint chown -R /data/project → PUID (đổi owner trên host bind).
# Dùng khi: đúng DEV_TEAM_PROJECT_PATH + PUID/PGID rồi vẫn EACCES trên path
# ngoài .dev-team-agent (vd. mkdir/src/** bị owner root từ lần chạy trước),
# và không sửa quyền trên host được. Không cần nếu chỉ sai path/PUID.
# FIX_PROJECT_OWNERSHIP=1
