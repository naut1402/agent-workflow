# cp docker/.env.example docker/.env

PUID=1000
PGID=1000
HOST_HOME=/home/youruser
DEV_TEAM_PROJECT_PATH=/home/youruser/workspace
# Host publish port only (browser → http://127.0.0.1:<port>/).
# Container always listens on 5174; compose maps <bind>:<port>:5174.
# Override: ./docker/install.sh --port=8080
DEV_TEAM_DASHBOARD_PORT=5174
# Bind address on the host (default 127.0.0.1 — not reachable from LAN).
# Opt-in for non-loopback: DEV_TEAM_DASHBOARD_BIND=0.0.0.0
# DEV_TEAM_DASHBOARD_BIND=127.0.0.1

# DEV_TEAM_DASHBOARD_TRANSPORT — cơ chế đẩy dữ liệu real-time (chat, automations,
# job log): sse (mặc định) hoặc polling. Đổi sang polling khi mạng nội bộ (proxy/
# gateway công ty) buffer response SSE dẫn đến mất cập nhật. Giá trị lạ/rỗng → sse.
# Đổi giá trị này cần restart container; không áp dụng cho phiên trình duyệt đang mở.
# DEV_TEAM_DASHBOARD_TRANSPORT=sse

# ANTHROPIC_API_KEY=
# CURSOR_API_KEY=
# CLAUDE_CODE_OAUTH_TOKEN=

# DASHBOARD_SECRET_KEY — bắt buộc để dùng credential "dán secret trực tiếp"
# hoặc "Connect via browser" (OAuth) trên Connection kind=ai-provider (openai-api/
# gemini-api/xai-api/anthropic-api). Mã hoá secret-vault.json (AES-256-GCM).
# Không set: 2 luồng đó fail rõ ("DASHBOARD_SECRET_KEY is not set…"); connection
# dùng CLI hoặc secretRef env:/file: không cần biến này.
# Sinh 1 lần lúc deploy, giữ nguyên (đổi key = mất khả năng đọc secret đã lưu):
#   openssl rand -hex 32
# DASHBOARD_SECRET_KEY=

# DASHBOARD_JWT_SECRET — bắt buộc để bật JWT auth middleware cho toàn bộ /api/*.
# Không set: middleware tự tắt (degrade), mọi request /api/* đi qua như hiện tại
# (không breaking change cho FE hiện có). Tách biệt hoàn toàn với DASHBOARD_SECRET_KEY
# (secret đó chỉ dùng để mã hoá secret-vault.json).
# Chưa có luồng issue-token trong dashboard — admin tự ký JWT bằng công cụ ngoài
# (vd. jwt.io, hoặc script `bun -e "..."` dùng `hono/jwt`'s `sign()`), dán token
# vào Settings > (localStorage `dev-team-api-token` qua console cho tới khi có UI).
# Sinh secret: openssl rand -hex 32
# DASHBOARD_JWT_SECRET=

# GH_TOKEN / GITHUB_TOKEN — fine-grained hoặc classic PAT (repo + pull_request).
# Cần để git push / gh pr create trong container (image đã có `gh`).
# Chỉ cần một trong hai; compose map GH_TOKEN → GITHUB_TOKEN nếu thiếu.
# GH_TOKEN=ghp_xxxxxxxx
# GITHUB_TOKEN=

# FIX_PROJECT_OWNERSHIP — mặc định 0 (tắt).
# Khi =1: entrypoint chown -R /data/project → PUID (đổi owner trên host bind).
# Dùng khi: đúng DEV_TEAM_PROJECT_PATH + PUID/PGID rồi vẫn EACCES trên path
# ngoài .dev-team-agent (vd. mkdir/src/** bị owner root từ lần chạy trước),
# và không sửa quyền trên host được. Không cần nếu chỉ sai path/PUID.
# FIX_PROJECT_OWNERSHIP=1

# rtk (Rust Token Killer) — nén output lệnh shell của agent trước khi vào context LLM.
# Binary được bake vào image; không có service, không có port, không có secret.
# Cả 4 biến dưới đây đều TUỲ CHỌN — không set biến nào thì rtk vẫn chạy đúng mặc định.
#
# RTK_VERSION — pin phiên bản (vX.Y.Z). Để trống = lấy release mới nhất lúc build.
# LÀ BUILD-ARG: đổi giá trị chỉ có tác dụng khi rebuild (./docker/install.sh --build).
# RTK_VERSION=v0.51.0
#
# RTK_REFRESH — giá trị đổi mỗi lần build để phá cache layer cài rtk. Cần khi RTK_VERSION
# trống mà muốn chắc chắn kéo bản latest mới thay vì dùng lại layer cũ.
# KHÔNG đặt trong file này: .env không chạy shell, `$(date +%s)` sẽ thành chuỗi hằng và
# không phá được cache (build im lặng trả về bản rtk cũ). Truyền từ dòng lệnh:
#   RTK_REFRESH=$(date +%s) ./docker/install.sh --build
# Mặc định: trống (dùng lại layer đã cache).
#
# RTK_HOOK_ENABLED — mặc định 1. Đặt 0 để tắt hook lúc runtime (không cần rebuild);
# agent chạy lệnh nguyên bản, không nén.
# RTK_HOOK_ENABLED=1
#
# RTK_TELEMETRY_DISABLED — mặc định 1 (chặn cứng). Telemetry của rtk vốn đã tắt
# theo mặc định upstream; biến này chặn thêm ở tầng env, không phụ thuộc build flag.
# RTK_TELEMETRY_DISABLED=1

# Corporate / MITM CA (SSL inspection: Fortinet, Zscaler, …).
# Không bắt buộc trong file này — install.sh đọc từ môi trường host nếu có:
#   NODE_EXTRA_CA_CERTS, SSL_CERT_FILE, REQUESTS_CA_BUNDLE, CURL_CA_BUNDLE
# Khi build, copy vào image (/etc/ssl/corp-ca/) + set cùng tên biến tới path trong container.
# Ví dụ (Windows path cũng được; Git Bash/MSYS sẽ normalize):
# NODE_EXTRA_CA_CERTS=C:\Users\you\cert\Fortinet_CA.cer
# SSL_CERT_FILE=C:\Users\you\cert\python-custom-ca-bundle.pem
# REQUESTS_CA_BUNDLE=C:\Users\you\cert\python-custom-ca-bundle.pem
