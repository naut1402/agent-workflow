{
  "name": "dev-team-dashboard",
  "private": true,
  "version": "1.0.5",
  "type": "module",
  "description": "Realtime dashboard for dev-agent-teams orchestrator state (.dev-team-agent/)",
  "scripts": {
    "dev": "bun --bun vite",
    "build": "vite build",
    "preview": "vite preview",
    "serve": "bun src/standalone.ts",
    "start": "vite build && bun src/standalone.ts",
    "mcp": "bun mcp/server.ts",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:commit": "commitlint",
    "check:todo": "bun .github/scripts/check-todo-debt.ts",
    "format": "prettier --write .",
    "test": "bun test tests/src/server tests/src/features/knowledge/business tests/src/features/logs/business tests/src/features/statistics/business tests/src/features/agent-editor/business tests/src/features/pipeline-editor/business tests/src/features/monitor/business tests/src/features/runner/business tests/src/core/lib/fileHelper.test.ts tests/src/core/log tests/src/core/events tests/mcp",
    "test:fe": "vitest run --coverage",
    "test:e2e": "playwright test --pass-with-no-tests",
    "test:all": "bun run typecheck && bun run lint && bun run test && bun run test:fe && bun run test:e2e"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "@hono/node-server": "^2.0.6",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@toast-ui/editor": "^3.2.2",
    "@vue-flow/core": "^1.41.0",
    "chart.js": "^4.5.1",
    "diff": "^9.0.0",
    "hono": "^4.12.27",
    "js-yaml": "^4.1.0",
    "marked": "^12.0.2",
    "mermaid": "^11.6.0",
    "openai": "^6.49.0",
    "vue": "^3.4.21",
    "vue-i18n": "^11.4.6",
    "zod": "3.25.76"
  },
  "overrides": {
    "openai": "6.49.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/types": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@types/bun": "^1.3.14",
    "@types/diff": "^8.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.0.1",
    "@vitejs/plugin-vue": "^5.0.4",
    "@vitest/coverage-v8": "^4.1.9",
    "@vue/test-utils": "^2.4.11",
    "@vueuse/core": "^11.0.0",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.9.2",
    "jsdom": "^29.1.1",
    "playwright": "^1.61.1",
    "prettier": "^3.9.5",
    "sass-embedded": "^1.100.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0",
    "vite": "^5.2.8",
    "vitest": "^4.1.9",
    "vue-tsc": "^3.3.5"
  }
}
