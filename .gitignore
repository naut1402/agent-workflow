node_modules/
dist/
CLAUDE.local.md

# Docker local secrets / machine paths
docker/.env
.env
.env.local

# Runtime staging — never commit
docker/.runtime/

# Staged corporate CA for image build (host copies via install.sh)
docker/certs/**
!docker/certs/.gitkeep
!docker/certs/README.md

# Orchestrator's own transient state for THIS repo (root only; e2e fixtures below
# are handled separately). Dashboard reads TARGET projects' .dev-team-agent/.
/.dev-team-agent/

# Test / coverage artifacts
coverage/
playwright-report/
test-results/
.vite/

# E2E runtime state (isolated registry home + mutable writes into the fixture)
# ── Cây test (Đợt 5: `tests/` + `test-e2e/` đã cắt sang dòng `test/**`) ─────────
# `bun run test:overlay` ghép cây test vào ĐÚNG chỗ cây tracked cũ, nên không
# ignore là sớm muộn có người `git add -A` và commit lại toàn bộ suite vào dòng
# source — đúng thứ Đợt 5 vừa bỏ đi.
#
# ⚠️ File này KHÔNG đi sang dòng test: `sync-source-to-test.yml` khai `.gitignore`
# trong `PRESERVE_PATHS`. Dòng test phải **track** hai thư mục này, nên hai dòng
# buộc phải lệch ở đúng chỗ đây.
/tests/
/test-e2e/

test-e2e/.runtime/
test-e2e/fixtures/project/.dev-team-agent/custom-agents/
test-e2e/fixtures/project/.dev-team-agent/agent-templates/
test-e2e/fixtures/project/.dev-team-agent/pipeline-profiles/
test-e2e/fixtures/project/.dev-team-agent/tasks/DEMO-1/paste-target.md
test-e2e/fixtures/project/.dev-team-agent/workflow-step-templates/
test-e2e/fixtures/project/.dev-team-agent/flow-profiles/
test-e2e/fixtures/project/.dev-team-agent/knowledge/
test-e2e/fixtures/project/.dev-team-agent/knowledge.config.yaml
test-e2e/fixtures/project/.dev-team-agent/pipeline.yaml
test-e2e/fixtures/project/.dev-team-agent/artifact-actions.yaml
test-e2e/fixtures/project/.dev-team-agent/automations/

# State cục bộ của công cụ AI agent (worktree, cache, settings.local) — chỉ tồn
# tại trên máy dev, không bao giờ commit.
.claude/

# Plugin Claude Code cài ở root — luôn là rác cục bộ / rò rỉ từ máy dev.
# Neo `/` để KHÔNG nuốt src/plugins/ (i18n thật).
/plugins/
