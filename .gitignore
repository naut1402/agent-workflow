dist/
CLAUDE.local.md

# Docker local secrets / machine paths
docker/.env
.env
.env.local

# Runtime staging — never commit
docker/.runtime/

# Staged corporate CA for image build (host copies via install.sh)
docker/certs/**
!docker/certs/.gitkeep
!docker/certs/README.md

# Orchestrator's own transient state for THIS repo (root only; e2e fixtures below
# are handled separately). Dashboard reads TARGET projects' .dev-team-agent/.
/.dev-team-agent/

# Test / coverage artifacts
coverage/
playwright-report/
test-results/
.vite/

# E2E runtime state (isolated registry home + mutable writes into the fixture)
test-e2e/.runtime/
test-e2e/fixtures/project/.dev-team-agent/custom-agents/
test-e2e/fixtures/project/.dev-team-agent/agent-templates/
test-e2e/fixtures/project/.dev-team-agent/pipeline-profiles/
test-e2e/fixtures/project/.dev-team-agent/workflow-step-templates/
test-e2e/fixtures/project/.dev-team-agent/flow-profiles/
